# Copy to .env (never commit .env or *.pem).
# Write the confirmation date next to every rule discovered through a live request.

HOST=https://partner-host.example
# Override paths if the partner uses a gateway prefix. These are also RELATIVE_PATH in stringToSign.
# PATH_TOKEN=/api/<prefix>/v1.0/access-token/b2b
# PATH_INQUIRY=/api/<prefix>/v1.0/transfer-va/inquiry
# PATH_PAYMENT=/api/<prefix>/v1.0/transfer-va/payment

CLIENT_KEY=
CLIENT_SECRET=
# X-PARTNER-ID: partner code from the partner, NOT the CLIENT_KEY.
PARTNER_ID=
# Send as-is, no zero padding.
CHANNEL_ID=
PRIVATE_KEY_FILE=rsa_private_key.pem

# Check the padding rule with the partner. If it must be space-padded to 8 chars, quote it:
#   PARTNER_SERVICE_ID="  899xxx"
PARTNER_SERVICE_ID=
VA_VALID=
VA_PAID=
VA_UNREGISTERED=
# A separate live VA for the Invalid Amount scenario (VA_VALID is paid by the payment scenario).
VA_MISMATCH=

AMOUNT_INQUIRY=0.00
AMOUNT_PAYMENT=99999999.00
AMOUNT=10000.00
CURRENCY=IDR
LOG_DIR=logs
